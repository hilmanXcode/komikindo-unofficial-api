# ----- Database -----
DATABASE_DSN="username:pwdbsql@tcp(127.0.0.1:3306)/db_komik?parseTime=true"

# ----- API key aplikasi -----
# Dikirim klien lewat header X-API-Key pada semua endpoint /v1.
SECRET_SELF_API_KEY="isibebassih"

# ----- Autentikasi user (JWT) -----
# Wajib diisi, minimal 32 karakter. Buat dengan: openssl rand -hex 32
JWT_SECRET=""

# Umur access token. Format durasi Go: 15m, 1h, 24h. Default 15m.
ACCESS_TOKEN_TTL="15m"

# Umur refresh token. Default 720h (30 hari).
REFRESH_TOKEN_TTL="720h"

# Jumlah gagal login sebelum akun dikunci sementara. Default 5.
MAX_LOGIN_ATTEMPTS="5"

# Lama akun dikunci setelah melewati batas. Default 15m.
LOGIN_LOCK_DURATION="15m"

# ----- Server -----
PORT="8000"

# Origin browser yang boleh memanggil API, dipisah koma. Kosongkan untuk memakai
# default: http://localhost:5173, http://localhost:4173, https://mangainaja.my.id
CORS_ORIGINS=""

# Batas request per IP untuk endpoint /v1. Default 10 request/detik, burst 30.
RATE_LIMIT_RPS="10"
RATE_LIMIT_BURST="30"

# Proxy yang header X-Forwarded-For-nya dipercaya, dipisah koma. Kosong berarti
# percaya semua. Isi dengan IP frontend/CDN di production agar IP pengunjung
# tidak bisa dipalsukan untuk menghindari rate limit.
TRUSTED_PROXIES=""
